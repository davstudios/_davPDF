{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "_davPDF",
  "version": "26.10.3",
  "identifier": "studio.dav.pdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17333",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "_davPDF",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local PDF toolbox",
    "longDescription": "_davPDF merges, splits, reorganizes, compresses, protects, converts and renders PDF documents locally without uploads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/pdfium/": "pdfium/"
    },
    "publisher": "_davstudios",
    "homepage": "https://davstudios.it",
    "copyright": "© 2026 _davstudios",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
